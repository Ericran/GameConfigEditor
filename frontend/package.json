    "test:watch": "vitest",
    "debug": "PLUGIN_PATH=./dist npx @gameap/debug"
  },
  "dependencies": {
    "@gameap/plugin-sdk": "^0.3.2"
  },
  "devDependencies": {
    "@gameap/debug": "^0.3.10",
    "@tailwindcss/postcss": "^4.1.18",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "2.2.7",
    "autoprefixer": "^10.4.23",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.22",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }

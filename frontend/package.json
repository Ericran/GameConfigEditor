{
  "name": "gameap-gameconfigeditor",
  "version": "2026.7.4",
  "description": "Game server config editor - GameAP plugin frontend",
  "type": "module",
  "main": "./dist/plugin.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
